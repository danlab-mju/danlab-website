---
import Logo from './Logo.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname).replace(/\/$/, '') || '/';
const items = [
  ['/', 'Home'],
  ['/news', "What's New"],
  ['/research', 'Research'],
  ['/team', 'Team'],
  ['/publications', 'Publications'],
  ['/awards', 'Awards'],
  ['/photos', 'Photos'],
  ['/media', 'Media'],
  ['/blacksand', 'Blacksand'],
];
---
<header class="site-header">
  <div class="wrap">
    <a href={base || '/'} class="brand">
      <Logo />
      <span class="brand-name">DAN Lab<small>DISTRIBUTED AI &amp; NETWORKED ROBOTICS</small></span>
    </a>
    <nav class="main-nav" aria-label="주 메뉴">
      {items.map(([href, label]) => (
        <a href={href === '/' ? (base || '/') : `${base}${href}`} aria-current={path === (href === '/' ? '/' : href) ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
  </div>
</header>
