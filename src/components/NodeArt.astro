---
// Signature: distributed nodes converging on a robot-arm silhouette
---
<svg class="node-art" viewBox="0 0 420 340" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="분산 노드 네트워크가 로봇 팔로 수렴하는 일러스트">
  <!-- link lines -->
  <g stroke="#d9d7cc" stroke-width="1.2">
    <line x1="60" y1="60" x2="180" y2="120"/>
    <line x1="340" y1="50" x2="180" y2="120"/>
    <line x1="390" y1="170" x2="255" y2="180"/>
    <line x1="40" y1="200" x2="150" y2="205"/>
    <line x1="90" y1="300" x2="180" y2="250"/>
    <line x1="60" y1="60" x2="40" y2="200"/>
    <line x1="340" y1="50" x2="390" y2="170"/>
  </g>
  <g stroke="#1d39f5" stroke-width="1.4">
    <line x1="180" y1="120" x2="210" y2="185"/>
    <line x1="255" y1="180" x2="210" y2="185"/>
    <line x1="180" y1="250" x2="210" y2="185"/>
  </g>
  <!-- outer nodes -->
  <g fill="#121210">
    <circle cx="60" cy="60" r="6"/>
    <circle cx="340" cy="50" r="6"/>
    <circle cx="390" cy="170" r="6"/>
    <circle cx="40" cy="200" r="6"/>
    <circle cx="90" cy="300" r="6"/>
  </g>
  <!-- inner nodes -->
  <g fill="#1d39f5">
    <circle cx="180" cy="120" r="7"/>
    <circle cx="255" cy="180" r="7"/>
    <circle cx="180" cy="250" r="7"/>
  </g>
  <!-- robot arm silhouette -->
  <g stroke="#121210" stroke-width="7" stroke-linecap="round">
    <line x1="210" y1="185" x2="250" y2="235"/>
    <line x1="250" y1="235" x2="300" y2="225"/>
    <line x1="300" y1="225" x2="322" y2="258"/>
  </g>
  <circle cx="210" cy="185" r="10" fill="#121210"/>
  <circle cx="250" cy="235" r="8" fill="#121210"/>
  <circle cx="300" cy="225" r="8" fill="#121210"/>
  <!-- gripper -->
  <g stroke="#1d39f5" stroke-width="5" stroke-linecap="round">
    <line x1="322" y1="258" x2="338" y2="252"/>
    <line x1="322" y1="258" x2="330" y2="274"/>
  </g>
  <!-- base -->
  <rect x="188" y="288" width="60" height="10" fill="#121210"/>
  <line x1="210" y1="185" x2="218" y2="288" stroke="#121210" stroke-width="7" stroke-linecap="round"/>
</svg>
