---
import Base from '../layouts/Base.astro';
import photos from '../data/photos.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// 기존 danlab.mju.ac.kr(Google Sites) Photos 페이지에서 백업한 사진들.
// 원본은 [홈페이지]/photos-backup/, 사진 추가는 public/photos/에 파일을 넣고 src/data/photos.json에 항목 추가.
const years = [...new Set(photos.map((p) => p.year))].sort((a, b) => b - a);
---
<Base title="Photos">
  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow"><i>01</i> / Photos</span>
        <h2>Lab Life</h2>
        <p>학회 발표, 수상, 연구실 행사의 순간들. 사진을 클릭하면 크게 볼 수 있습니다.</p>
      </div>
      {years.map((y) => (
        <div>
          <h3 class="photo-year">{y}</h3>
          <div class="photo-grid">
            {photos.filter((p) => p.year === y).map((p) => (
              <figure class="photo-card">
                <button
                  class="photo-zoom"
                  type="button"
                  data-src={`${base}/photos/${p.file}`}
                  data-caption={p.caption || `DAN Lab ${y}`}
                  aria-label="사진 크게 보기"
                >
                  <img src={`${base}/photos/${p.file}`} alt={p.caption || `DAN Lab ${y}`} loading="lazy" />
                </button>
                {p.caption && <figcaption>{p.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <dialog class="lightbox" id="lightbox">
    <figure>
      <img id="lightbox-img" src="" alt="" />
      <figcaption id="lightbox-cap"></figcaption>
    </figure>
  </dialog>

  <script>
    const dlg = document.getElementById('lightbox') as HTMLDialogElement;
    const img = document.getElementById('lightbox-img') as HTMLImageElement;
    const cap = document.getElementById('lightbox-cap') as HTMLElement;
    document.querySelectorAll<HTMLButtonElement>('.photo-zoom').forEach((btn) => {
      btn.addEventListener('click', () => {
        img.src = btn.dataset.src ?? '';
        img.alt = btn.dataset.caption ?? '';
        cap.textContent = btn.dataset.caption ?? '';
        dlg.showModal();
      });
    });
    dlg.addEventListener('click', () => dlg.close());
  </script>
</Base>
