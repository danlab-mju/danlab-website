---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const all = (await getCollection('publications')).sort(
  (a, b) => b.data.year - a.data.year || a.id.localeCompare(b.id)
);
const journals = all.filter((p) => p.data.type === 'journal');
const conferences = all.filter((p) => p.data.type === 'conference');
const submitted = all.filter((p) => p.data.type === 'submitted');
const SHOW = 8; // 접기 전 보여줄 개수
---
<Base title="Publications">
  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow"><i>01</i> / Publications</span>
        <h2>Submitted papers</h2>
      </div>
      <div class="pub-list">
        {submitted.map((p) => (
          <article class="pub">
            <div class="year">{p.data.year}</div>
            <div>
              <div class="title">{p.data.title}</div>
              <div class="authors">{p.data.authors}</div>
              <div class="venue">{p.data.venue}</div>
              {p.data.note && <div class="note">{p.data.note}</div>}
            </div>
          </article>
        ))}
      </div>

      <div class="section-head" style="margin-top:56px;">
        <h2>Journal papers</h2>
      </div>
      <div class="pub-list collapsed" id="journal-list">
        {journals.map((p, i) => (
          <article class={i >= SHOW ? 'pub extra' : 'pub'}>
            <div class="year">{p.data.year}</div>
            <div>
              <div class="title">{p.data.link ? <a href={p.data.link}>{p.data.title}</a> : p.data.title}</div>
              <div class="authors">{p.data.authors}</div>
              <div class="venue">{p.data.venue}</div>
              {p.data.note && <div class="note">{p.data.note}</div>}
            </div>
          </article>
        ))}
      </div>
      {journals.length > SHOW && (
        <button class="show-more" type="button" data-target="journal-list">더보기 · {journals.length - SHOW} more</button>
      )}

      <div class="section-head" style="margin-top:56px;">
        <h2>Conference papers</h2>
      </div>
      <div class="pub-list collapsed" id="conference-list">
        {conferences.map((p, i) => (
          <article class={i >= SHOW ? 'pub extra' : 'pub'}>
            <div class="year">{p.data.year}</div>
            <div>
              <div class="title">{p.data.link ? <a href={p.data.link}>{p.data.title}</a> : p.data.title}</div>
              <div class="authors">{p.data.authors}</div>
              <div class="venue">{p.data.venue}</div>
              {p.data.note && <div class="note">{p.data.note}</div>}
            </div>
          </article>
        ))}
      </div>
      {conferences.length > SHOW && (
        <button class="show-more" type="button" data-target="conference-list">더보기 · {conferences.length - SHOW} more</button>
      )}
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLButtonElement>('.show-more').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.getElementById(btn.dataset.target ?? '')?.classList.remove('collapsed');
        btn.remove();
      });
    });
  </script>
</Base>
