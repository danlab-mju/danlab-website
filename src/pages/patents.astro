---
<Base title="Patents" description="DAN Lab 특허 — 국내 특허 출원·등록 목록">
  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow"><i>01</i> / Patents</span>
        <h2>특허</h2>
      </div>
      <div class="pub-list">
        {patents.map((p) => (
          <article class="pub">
            <div class="year">{p.year}</div>
            <div>
              <div class="title">{p.title}</div>
              {p.authors && <div class="authors">{p.authors}</div>}
              <div class="venue">
                출원번호 {p.appNo} · {p.date}
                {p.regNo && ` · 등록번호 ${p.regNo} (${p.regDate})`}
              </div>
              {p.note && <div class="note">{p.note}</div>}
            </div>
          </article>
        ))}
      </div>

      <div class="section-head" style="margin-top:56px;">
        <h2>Patents before 2017</h2>
      </div>
      <a class="btn" href={`${base}/professor`}>Director profile</a>
    </div>
  </section>
</Base>
