---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const news = (await getCollection('news')).sort((a, b) => b.data.sort - a.data.sort);
---
<Base title="What's New">
  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">What's new</span>
        <h2>Lab news</h2>
      </div>
      <div class="news-list">
        {news.map((n) => (
          <div class="news-item">
            <div class="date">{n.data.date}</div>
            <div class="body">{n.data.body}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
